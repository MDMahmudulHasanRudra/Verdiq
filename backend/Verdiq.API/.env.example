# Verdiq - Backend Environment Configuration
# Copy this to appsettings.Development.json or set as environment variables

# Database
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=VerdiqDb;Username=postgres;Password=your_password"

# JWT Authentication
Jwt__Key="YourSuperSecretKeyHereAtLeast32CharactersLong"
Jwt__Issuer="Verdiq"
Jwt__Audience="VerdiqApp"

# Document Storage
DocumentStorage__BasePath="./UploadedDocuments"

# Logging
Serilog__MinimumLevel__Default="Information"
Serilog__MinimumLevel__Override__Microsoft="Warning"
Serilog__MinimumLevel__Override__Microsoft.AspNetCore="Warning"
